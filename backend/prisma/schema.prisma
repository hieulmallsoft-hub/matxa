generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AuthProvider {
  PHONE
  GOOGLE
  EMAIL
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ServiceMode {
  HOME
  ONSITE
  ONLINE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PromotionType {
  PERCENT
  FIXED
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  displayName String?        @map("display_name")
  avatarUrl   String?        @map("avatar_url")
  avatarKey   String?        @map("avatar_key")
  gender      Gender?
  nationality String?
  status      UserStatus     @default(ACTIVE)
  role        UserRole       @default(CUSTOMER)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  identities  UserIdentity[]
  sessions    Session[]
  notifications Notification[]
  deviceTokens DeviceToken[]
  conversationMembers ConversationMember[]
  sentMessages Message[] @relation("MessageSender")
  technicianProfile TechnicianProfile?
  favorites Favorite[]
  customerBookings Booking[] @relation("BookingCustomer")
  addresses Address[]
  promotionUsages PromotionUsage[]
  reviews Review[]

  @@map("users")
}

model TechnicianProfile {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @unique @map("user_id") @db.Uuid
  bio             String?
  gender          Gender?
  tags            String[]            @default([])
  serviceModes    ServiceMode[]       @default([]) @map("service_modes")
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  city            String?
  address         String?
  isVerified      Boolean             @default(false) @map("is_verified")
  isAvailable     Boolean             @default(false) @map("is_available")
  averageRating   Decimal             @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount     Int                 @default(0) @map("review_count")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        TechnicianService[]
  availability    AvailabilitySlot[]
  favorites       Favorite[]
  bookings        Booking[]
  reviews         Review[]

  @@index([city, isAvailable])
  @@index([averageRating(sort: Desc)])
  @@map("technician_profiles")
}

model ServiceCategory {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  slug      String              @unique
  iconUrl   String?             @map("icon_url")
  isActive  Boolean             @default(true) @map("is_active")
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  services  TechnicianService[]

  @@map("service_categories")
}

model TechnicianService {
  id              String             @id @default(uuid()) @db.Uuid
  technicianId    String             @map("technician_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int                @map("duration_minutes")
  price           Decimal            @db.Decimal(12, 2)
  modes           ServiceMode[]      @default([])
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  technician      TechnicianProfile  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category        ServiceCategory    @relation(fields: [categoryId], references: [id])
  bookingItems    BookingItem[]

  @@index([technicianId, isActive])
  @@index([categoryId, isActive])
  @@map("technician_services")
}

model AvailabilitySlot {
  id           String            @id @default(uuid()) @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  startAt      DateTime          @map("start_at")
  endAt        DateTime          @map("end_at")
  isAvailable  Boolean           @default(true) @map("is_available")
  createdAt    DateTime          @default(now()) @map("created_at")
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, startAt, endAt])
  @@map("availability_slots")
}

model Favorite {
  userId       String            @map("user_id") @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([userId, technicianId])
  @@index([technicianId])
  @@map("favorites")
}

model Address {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  label     String?
  address   String
  latitude  Decimal   @db.Decimal(10, 7)
  longitude Decimal   @db.Decimal(10, 7)
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([userId])
  @@map("addresses")
}

model Promotion {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  name           String
  type           PromotionType
  value          Decimal          @db.Decimal(12, 2)
  minOrderAmount Decimal          @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?         @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?             @map("usage_limit")
  perUserLimit   Int              @default(1) @map("per_user_limit")
  usedCount      Int              @default(0) @map("used_count")
  startsAt       DateTime         @map("starts_at")
  endsAt         DateTime         @map("ends_at")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  usages         PromotionUsage[]
  bookings       Booking[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Booking {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  technicianId    String            @map("technician_id") @db.Uuid
  addressId       String?           @map("address_id") @db.Uuid
  promotionId     String?           @map("promotion_id") @db.Uuid
  mode            ServiceMode
  status          BookingStatus     @default(PENDING)
  scheduledStart  DateTime          @map("scheduled_start")
  scheduledEnd    DateTime          @map("scheduled_end")
  subtotal        Decimal           @db.Decimal(12, 2)
  serviceFee      Decimal           @default(0) @map("service_fee") @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(12, 2)
  note            String?
  cancelledAt     DateTime?         @map("cancelled_at")
  cancellationReason String?        @map("cancellation_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  customer        User              @relation("BookingCustomer", fields: [customerId], references: [id])
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id])
  address         Address?          @relation(fields: [addressId], references: [id])
  promotion       Promotion?        @relation(fields: [promotionId], references: [id])
  items           BookingItem[]
  payment         Payment?
  review          Review?
  promotionUsage  PromotionUsage?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, scheduledStart])
  @@map("bookings")
}

model BookingItem {
  id              String            @id @default(uuid()) @db.Uuid
  bookingId       String            @map("booking_id") @db.Uuid
  serviceId       String            @map("service_id") @db.Uuid
  serviceName     String            @map("service_name")
  durationMinutes Int               @map("duration_minutes")
  unitPrice       Decimal           @map("unit_price") @db.Decimal(12, 2)
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service         TechnicianService @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @unique @map("booking_id") @db.Uuid
  method      PaymentMethod
  status      PaymentStatus @default(UNPAID)
  amount      Decimal       @db.Decimal(12, 2)
  provider    String?
  providerRef String?       @map("provider_ref")
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PromotionUsage {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  usedAt      DateTime  @default(now()) @map("used_at")
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([promotionId, userId])
  @@map("promotion_usages")
}

model Review {
  id           String            @id @default(uuid()) @db.Uuid
  bookingId    String            @unique @map("booking_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  rating       Int
  comment      String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  booking      Booking           @relation(fields: [bookingId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id])

  @@index([technicianId, createdAt(sort: Desc)])
  @@map("reviews")
}

model HomeBanner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  subtitle  String?
  imageUrl  String   @map("image_url")
  actionUrl String?  @map("action_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("home_banners")
}

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  participantKey String              @unique @map("participant_key")
  lastMessageAt DateTime?            @map("last_message_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  hiddenAt       DateTime?    @map("hidden_at")
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, hiddenAt])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  type           MessageType
  text           String?
  mediaUrl       String?      @map("media_url")
  mediaKey       String?      @map("media_key")
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  address        String?
  bookingId      String?      @map("booking_id") @db.Uuid
  editedAt       DateTime?    @map("edited_at")
  recalledAt     DateTime?    @map("recalled_at")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String   @default("ANDROID")
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  actionUrl String?   @map("action_url")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model UserIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  phoneNumber     String?      @map("phone_number")
  email           String?
  emailVerified   Boolean      @default(false) @map("email_verified")
  passwordHash    String?      @map("password_hash")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}
