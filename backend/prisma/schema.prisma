generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AuthProvider {
  PHONE
  GOOGLE
  EMAIL
  APPLE
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
  SYSTEM
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ServiceMode {
  HOME
  ONSITE
  ONLINE
}

enum BookingStatus {
  OPEN
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingAssignmentMode {
  DIRECT
  OPEN_MARKETPLACE
}

enum BookingTechnicianApplicationStatus {
  APPLIED
  SELECTED
  NOT_SELECTED
  WITHDRAWN
  DECLINED
  EXPIRED
}

enum ServiceCatalogPricingTemplate {
  STANDARD_60_90_120
  FIXED_60
  DATE_2_4_6_HOURS
}

enum CancellationReasonCode {
  NO_LONGER_NEEDED
  SERVICE_ISSUE
  PAYMENT_REFUND_ISSUE
  CUSTOMER_NO_SHOW
  UNSAFE_SITUATION
  INAPPROPRIATE_REQUEST
  SERVICE_LOCATION_UNAVAILABLE
  CUSTOMER_REQUESTED_CANCEL
  OTHER
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WalletType {
  ADVERTISING_CREDIT
}
enum TopUpStatus {
  PENDING_PAYMENT
  PROCESSING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}
enum WalletTransactionType {
  TOP_UP
}
enum WalletPaymentMethod {
  BANK_TRANSFER
}

enum PromotionType {
  PERCENT
  FIXED
}

enum TechnicianApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum TechnicianKycStatus {
  NOT_STARTED
  ID_UPLOADED
  FACE_UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum TechnicianKycDocumentType {
  ID_CARD_FRONT
  ID_CARD_BACK
  FACE_IMAGE
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  displayName String?        @map("display_name")
  avatarUrl   String?        @map("avatar_url")
  avatarKey   String?        @map("avatar_key")
  gender      Gender?
  nationality String?
  status      UserStatus     @default(ACTIVE)
  role        UserRole       @default(CUSTOMER)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  identities  UserIdentity[]
  sessions    Session[]
  notifications Notification[]
  deviceTokens DeviceToken[]
  conversationMembers ConversationMember[]
  customerBookingConversations Conversation[] @relation("BookingConversationCustomer")
  technicianBookingConversations Conversation[] @relation("BookingConversationTechnician")
  sentMessages Message[] @relation("MessageSender")
  technicianProfile TechnicianProfile?
  favorites Favorite[]
  customerBookings Booking[] @relation("BookingCustomer")
  addresses Address[]
  promotionUsages PromotionUsage[]
  reviews Review[]
  technicianApplication TechnicianApplication?
  wallets               Wallet[]
  topUpTransactions     TopUpTransaction[]
  bookingCancellations  BookingCancellation[] @relation("BookingCancellationActor")

  @@map("users")
}

model TechnicianApplication {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  status         TechnicianApplicationStatus @default(DRAFT)
  applicationType String? @map("application_type")
  displayName    String?  @map("display_name")
  gender         Gender?
  city           String?
  district       String?
  facility       String?
  address        String?
  bio            String?
  supportedModes ServiceMode[] @default([]) @map("supported_modes")
  idCardFrontKey String?  @map("id_card_front_key")
  idCardBackKey  String?  @map("id_card_back_key")
  faceImageKey   String?  @map("face_image_key")
  rejectionReason String? @map("rejection_reason")
  submittedAt      DateTime? @map("submitted_at")
  underReviewAt    DateTime? @map("under_review_at")
  approvedAt       DateTime? @map("approved_at")
  rejectedAt       DateTime? @map("rejected_at")
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc            TechnicianKyc?
  gallery        TechnicianApplicationGalleryImage[]
  @@index([status, createdAt(sort: Desc)])
  @@map("technician_applications")
}

model TechnicianKyc {
  id              String              @id @default(uuid()) @db.Uuid
  applicationId   String              @unique @map("application_id") @db.Uuid
  status          TechnicianKycStatus  @default(NOT_STARTED)
  rejectionReason String?              @map("rejection_reason")
  reviewedBy      String?              @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?            @map("reviewed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  application     TechnicianApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documents       TechnicianKycDocument[]
  @@map("technician_kyc")
}

model TechnicianKycDocument {
  id          String                    @id @default(uuid()) @db.Uuid
  kycId       String                    @map("kyc_id") @db.Uuid
  type        TechnicianKycDocumentType
  storageKey  String                    @map("storage_key")
  contentType String                    @map("content_type")
  fileSize    Int                       @map("file_size")
  createdAt   DateTime                  @default(now()) @map("created_at")
  kyc         TechnicianKyc              @relation(fields: [kycId], references: [id], onDelete: Cascade)
  @@unique([kycId, type])
  @@map("technician_kyc_documents")
}

model TechnicianApplicationGalleryImage {
  id            String                @id @default(uuid()) @db.Uuid
  applicationId String                @map("application_id") @db.Uuid
  storageKey    String                @map("storage_key")
  sortOrder     Int                   @default(0) @map("sort_order")
  createdAt     DateTime              @default(now()) @map("created_at")
  application   TechnicianApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, sortOrder])
  @@map("technician_application_gallery")
}

model TechnicianProfile {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @unique @map("user_id") @db.Uuid
  bio             String?
  gender          Gender?
  tags            String[]            @default([])
  serviceModes    ServiceMode[]       @default([]) @map("service_modes")
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  city            String?
  district        String?
  facility        String?
  address         String?
  isVerified      Boolean             @default(false) @map("is_verified")
  isActive        Boolean             @default(true) @map("is_active")
  isAvailable     Boolean             @default(false) @map("is_available")
  averageRating   Decimal             @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount     Int                 @default(0) @map("review_count")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        TechnicianService[]
  availability    AvailabilitySlot[]
  favorites       Favorite[]
  bookings        Booking[]
  reviews         Review[]
  bookingApplications BookingTechnicianApplication[]

  @@index([city, isAvailable])
  @@index([isActive, isAvailable(sort: Desc), averageRating(sort: Desc), id])
  @@index([tags], type: Gin)
  @@index([averageRating(sort: Desc)])
  @@map("technician_profiles")
}

model ServiceCategory {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  slug      String              @unique
  iconUrl   String?             @map("icon_url")
  isActive  Boolean             @default(true) @map("is_active")
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  services  TechnicianService[]
  catalogItems ServiceCatalogItem[]
  bookingItems BookingItem[]

  @@map("service_categories")
}

// Platform-owned catalog used by OPEN_MARKETPLACE bookings.  Its prices and
// duration are copied to BookingItem so later catalog edits never alter history.
model ServiceCatalogItem {
  id              String          @id @default(uuid()) @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  slug            String          @unique
  name            String
  description     String?
  durationMinutes Int             @map("duration_minutes")
  price           Decimal         @db.Decimal(12, 2)
  pricingTemplate ServiceCatalogPricingTemplate @default(FIXED_60) @map("pricing_template")
  sortOrder       Int             @default(0) @map("sort_order")
  modes           ServiceMode[]   @default([])
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  bookingItems    BookingItem[]
  priceOptions    ServiceCatalogPriceOption[]

  @@index([categoryId, isActive, sortOrder])
  @@map("service_catalog_items")
}

model ServiceCatalogPriceOption {
  id              String             @id @default(uuid()) @db.Uuid
  catalogServiceId String             @map("catalog_service_id") @db.Uuid
  code            String
  durationMinutes Int                @map("duration_minutes")
  price           Decimal            @db.Decimal(12, 2)
  isActive        Boolean            @default(true) @map("is_active")
  sortOrder       Int                @default(0) @map("sort_order")
  catalogService  ServiceCatalogItem @relation(fields: [catalogServiceId], references: [id], onDelete: Cascade)
  bookingItems    BookingItem[]

  @@unique([catalogServiceId, code])
  @@index([catalogServiceId, isActive, sortOrder])
  @@map("service_catalog_price_options")
}

model City {
  code      String     @id
  name      String
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(0) @map("sort_order")
  districts District[]
  @@map("cities")
}

model District {
  code      String  @id
  cityCode  String  @map("city_code")
  name      String
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  city      City    @relation(fields: [cityCode], references: [code], onDelete: Cascade)
  @@index([cityCode, isActive, sortOrder])
  @@map("districts")
}

model TechnicianService {
  id              String             @id @default(uuid()) @db.Uuid
  technicianId    String             @map("technician_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int                @map("duration_minutes")
  price           Decimal            @db.Decimal(12, 2)
  modes           ServiceMode[]      @default([])
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  technician      TechnicianProfile  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category        ServiceCategory    @relation(fields: [categoryId], references: [id])
  bookingItems    BookingItem[]
  priceOptions    TechnicianServicePriceOption[]

  @@index([technicianId, isActive])
  @@index([categoryId, isActive])
  @@map("technician_services")
}

model TechnicianServicePriceOption {
  id                 String             @id @default(uuid()) @db.Uuid
  technicianServiceId String            @map("technician_service_id") @db.Uuid
  code               String
  durationMinutes    Int                @map("duration_minutes")
  price              Decimal            @db.Decimal(12, 2)
  isActive           Boolean            @default(true) @map("is_active")
  sortOrder          Int                @default(0) @map("sort_order")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  technicianService  TechnicianService  @relation(fields: [technicianServiceId], references: [id], onDelete: Cascade)
  @@unique([technicianServiceId, code])
  @@index([technicianServiceId, isActive])
  @@map("technician_service_price_options")
}

model AvailabilitySlot {
  id           String            @id @default(uuid()) @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  startAt      DateTime          @map("start_at")
  endAt        DateTime          @map("end_at")
  isAvailable  Boolean           @default(true) @map("is_available")
  createdAt    DateTime          @default(now()) @map("created_at")
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, startAt, endAt])
  @@map("availability_slots")
}

model Favorite {
  userId       String            @map("user_id") @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([userId, technicianId])
  @@index([technicianId])
  @@map("favorites")
}

model Address {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  label     String?
  address   String
  latitude  Decimal   @db.Decimal(10, 7)
  longitude Decimal   @db.Decimal(10, 7)
  isDefault Boolean   @default(false) @map("is_default")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([userId])
  @@map("addresses")
}

model Promotion {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  name           String
  type           PromotionType
  value          Decimal          @db.Decimal(12, 2)
  minOrderAmount Decimal          @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?         @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?             @map("usage_limit")
  perUserLimit   Int              @default(1) @map("per_user_limit")
  usedCount      Int              @default(0) @map("used_count")
  startsAt       DateTime         @map("starts_at")
  endsAt         DateTime         @map("ends_at")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  usages         PromotionUsage[]
  bookings       Booking[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Booking {
  id              String            @id @default(uuid()) @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  technicianId    String?           @map("technician_id") @db.Uuid
  assignmentMode  BookingAssignmentMode @default(DIRECT) @map("assignment_mode")
  applicationDeadlineAt DateTime?   @map("application_deadline_at")
  addressId       String?           @map("address_id") @db.Uuid
  addressSnapshot Json?             @map("address_snapshot")
  promotionId     String?           @map("promotion_id") @db.Uuid
  mode            ServiceMode
  status          BookingStatus     @default(PENDING)
  scheduledStart  DateTime          @map("scheduled_start")
  scheduledEnd    DateTime          @map("scheduled_end")
  subtotal        Decimal           @db.Decimal(12, 2)
  serviceFee      Decimal           @default(0) @map("service_fee") @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal           @map("total_amount") @db.Decimal(12, 2)
  note            String?
  cancelledAt     DateTime?         @map("cancelled_at")
  cancellationReason String?        @map("cancellation_reason")
  cancellationReasonCode CancellationReasonCode? @map("cancellation_reason_code")
  cancellationReasonText String? @map("cancellation_reason_text")
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  cancelledByRole UserRole? @map("cancelled_by_role")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  customer        User              @relation("BookingCustomer", fields: [customerId], references: [id])
  technician      TechnicianProfile? @relation(fields: [technicianId], references: [id])
  address         Address?          @relation(fields: [addressId], references: [id])
  promotion       Promotion?        @relation(fields: [promotionId], references: [id])
  items           BookingItem[]
  payment         Payment?
  review          Review?
  promotionUsage  PromotionUsage?
  applications    BookingTechnicianApplication[]
  conversation    Conversation?
  cancellation    BookingCancellation?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, scheduledStart])
  @@index([assignmentMode, status, scheduledStart])
  @@map("bookings")
}

model BookingItem {
  id              String            @id @default(uuid()) @db.Uuid
  bookingId       String            @map("booking_id") @db.Uuid
  serviceId       String?           @map("service_id") @db.Uuid
  catalogServiceId String?          @map("catalog_service_id") @db.Uuid
  catalogPriceOptionId String?      @map("catalog_price_option_id") @db.Uuid
  categoryId      String?           @map("category_id") @db.Uuid
  categoryName    String?           @map("category_name")
  priceOptionId   String?           @map("price_option_id") @db.Uuid
  priceOptionCode String?           @map("price_option_code")
  serviceName     String            @map("service_name")
  durationMinutes Int               @map("duration_minutes")
  unitPrice       Decimal           @map("unit_price") @db.Decimal(12, 2)
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service         TechnicianService? @relation(fields: [serviceId], references: [id])
  catalogService  ServiceCatalogItem? @relation(fields: [catalogServiceId], references: [id])
  catalogPriceOption ServiceCatalogPriceOption? @relation(fields: [catalogPriceOptionId], references: [id])
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([bookingId])
  @@index([catalogServiceId])
  @@index([catalogPriceOptionId])
  @@map("booking_items")
}

model BookingTechnicianApplication {
  id                  String                              @id @default(uuid()) @db.Uuid
  bookingId           String                              @map("booking_id") @db.Uuid
  technicianProfileId String                              @map("technician_profile_id") @db.Uuid
  status              BookingTechnicianApplicationStatus
  appliedAt           DateTime?                           @map("applied_at")
  selectedAt          DateTime?                           @map("selected_at")
  withdrawnAt         DateTime?                           @map("withdrawn_at")
  declinedAt          DateTime?                           @map("declined_at")
  expiredAt           DateTime?                           @map("expired_at")
  createdAt           DateTime                            @default(now()) @map("created_at")
  updatedAt           DateTime                            @updatedAt @map("updated_at")
  booking             Booking                             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technicianProfile   TechnicianProfile                   @relation(fields: [technicianProfileId], references: [id], onDelete: Cascade)

  @@unique([bookingId, technicianProfileId])
  @@index([bookingId, status])
  @@index([technicianProfileId, status])
  @@map("booking_technician_applications")
}

model BookingCancellation {
  id          String                  @id @default(uuid()) @db.Uuid
  bookingId   String                  @unique @map("booking_id") @db.Uuid
  actorUserId String                  @map("actor_user_id") @db.Uuid
  actorRole   UserRole                @map("actor_role")
  reasonCode  CancellationReasonCode  @map("reason_code")
  reasonText  String?                 @map("reason_text")
  cancelledAt DateTime                @map("cancelled_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  booking     Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User                    @relation("BookingCancellationActor", fields: [actorUserId], references: [id])
  evidence    BookingCancellationEvidence[]

  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("booking_cancellations")
}

model BookingCancellationEvidence {
  id             String              @id @default(uuid()) @db.Uuid
  cancellationId String              @map("cancellation_id") @db.Uuid
  storageKey     String              @map("storage_key")
  mediaType      String              @map("media_type")
  createdAt      DateTime            @default(now()) @map("created_at")
  cancellation   BookingCancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)

  @@unique([cancellationId, storageKey])
  @@map("booking_cancellation_evidence")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  bookingId   String        @unique @map("booking_id") @db.Uuid
  method      PaymentMethod
  status      PaymentStatus @default(UNPAID)
  amount      Decimal       @db.Decimal(12, 2)
  provider    String?
  providerRef String?       @map("provider_ref")
  providerTransactionNo String? @map("provider_transaction_no")
  bankCode    String?       @map("bank_code")
  bankTranNo  String?       @map("bank_tran_no")
  responseCode String?      @map("response_code")
  expiresAt   DateTime?     @map("expires_at")
  ipnReceivedAt DateTime?   @map("ipn_received_at")
  refundRef   String?       @map("refund_ref")
  refundedAt  DateTime?     @map("refunded_at")
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([status, expiresAt])
  @@map("payments")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  type         WalletType
  balanceVnd   Int                 @default(0) @map("balance_vnd")
  currency     String              @default("VND")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  topUps       TopUpTransaction[]
  ledger       WalletLedgerEntry[]
  @@unique([userId, type])
  @@map("wallets")
}

model TopUpTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  walletId              String              @map("wallet_id") @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  amountVnd             Int                 @map("amount_vnd")
  currency              String              @default("VND")
  status                TopUpStatus         @default(PENDING_PAYMENT)
  paymentMethod         WalletPaymentMethod @map("payment_method")
  referenceCode         String              @unique @map("reference_code")
  providerTransactionId String?             @unique @map("provider_transaction_id")
  failureCode           String?             @map("failure_code")
  failureMessage        String?             @map("failure_message")
  expiresAt             DateTime            @map("expires_at")
  processedAt           DateTime?           @map("processed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  wallet                Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries         WalletLedgerEntry[]
  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId, status])
  @@map("top_up_transactions")
}

model WalletLedgerEntry {
  id              String                 @id @default(uuid()) @db.Uuid
  walletId        String                 @map("wallet_id") @db.Uuid
  topUpId         String?                @map("top_up_id") @db.Uuid
  type            WalletTransactionType
  amountVnd       Int                    @map("amount_vnd")
  balanceBeforeVnd Int                   @map("balance_before_vnd")
  balanceAfterVnd  Int                   @map("balance_after_vnd")
  referenceType   String                 @map("reference_type")
  referenceId     String                 @map("reference_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  wallet          Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  topUp           TopUpTransaction?      @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  @@unique([referenceType, referenceId])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_ledger_entries")
}

model PromotionUsage {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  usedAt      DateTime  @default(now()) @map("used_at")
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([promotionId, userId])
  @@map("promotion_usages")
}

model Review {
  id           String            @id @default(uuid()) @db.Uuid
  bookingId    String            @unique @map("booking_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  technicianId String            @map("technician_id") @db.Uuid
  rating       Int
  comment      String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  booking      Booking           @relation(fields: [bookingId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id])

  @@index([technicianId, createdAt(sort: Desc)])
  @@map("reviews")
}

model HomeBanner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  subtitle  String?
  imageUrl  String   @map("image_url")
  actionUrl String?  @map("action_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("home_banners")
}

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  // Null values represent legacy direct conversations. New booking chats are
  // isolated by bookingId so the same customer/KTV can have separate threads.
  bookingId     String?              @unique @map("booking_id") @db.Uuid
  customerId    String?              @map("customer_id") @db.Uuid
  technicianUserId String?           @map("technician_user_id") @db.Uuid
  participantKey String              @map("participant_key")
  lastMessageAt DateTime?            @map("last_message_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  members       ConversationMember[]
  messages      Message[]
  booking       Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer      User?                @relation("BookingConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  technicianUser User?               @relation("BookingConversationTechnician", fields: [technicianUserId], references: [id], onDelete: SetNull)

  @@index([lastMessageAt(sort: Desc)])
  @@index([participantKey])
  @@index([customerId, technicianUserId])
  @@map("conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  hiddenAt       DateTime?    @map("hidden_at")
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, hiddenAt])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  type           MessageType
  text           String?
  mediaUrl       String?      @map("media_url")
  mediaKey       String?      @map("media_key")
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  address        String?
  bookingId      String?      @map("booking_id") @db.Uuid
  editedAt       DateTime?    @map("edited_at")
  recalledAt     DateTime?    @map("recalled_at")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String   @default("ANDROID")
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  actionUrl String?   @map("action_url")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model UserIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  phoneNumber     String?      @map("phone_number")
  email           String?
  emailVerified   Boolean      @default(false) @map("email_verified")
  passwordHash    String?      @map("password_hash")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}
