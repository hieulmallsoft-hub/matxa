# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matxa?schema=public"

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# JWT cua Matxa (dung chuoi ngau nhien dai it nhat 32 ky tu)
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=

# Phone OTP
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT_PER_HOUR=5
OTP_IP_LIMIT_PER_HOUR=20
OTP_DEVICE_LIMIT_PER_HOUR=10

# "development" chi dung khi NODE_ENV khac production.
SMS_PROVIDER=development
EMAIL_PROVIDER=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Matxa <your-account@gmail.com>"
SMS_DEV_CODE=123456

# Firebase Admin service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# S3-compatible object storage for chat images
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for MinIO/Cloudflare R2/other S3-compatible providers
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
HOME_SERVICE_FEE=100000

# Internal only: used by `npm run db:seed-admin`; never expose these in a client.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME="Matxa Administrator"
# Set true only when deliberately resetting an existing admin's password.
ADMIN_RESET_PASSWORD=false

# OAuth 2.0 Client ID loai Web application, dung chung cho Android va backend
GOOGLE_CLIENT_ID=893400153438-pg4roc9tkcbffb1voio5m04k235mldn4.apps.googleusercontent.com

# Apple Bundle ID (iOS) va Services ID (neu co web/Android), cach nhau boi dau phay
APPLE_CLIENT_IDS=

# VNPAY. Keep HASH_SECRET on the server only. Use sandbox URL until production is approved.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNPAY_PAYMENT_TTL_MINUTES=15
# OPEN marketplace application deadline and idempotent expiry worker.
OPEN_BOOKING_APPLICATION_TTL_MINUTES=60
OPEN_BOOKING_EXPIRATION_INTERVAL_SECONDS=60
OPEN_BOOKING_EXPIRATION_BATCH_SIZE=100
# Configure this public URL in the VNPAY merchant portal:
# https://your-api-host/api/payments/vnpay/ipn
